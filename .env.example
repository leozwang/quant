# Supabase Cloud Database Configuration Template
# Copy this file to .env and fill in your Supabase project credentials.

SUPABASE_PROJECT_ID=<your-project-id>
SUPABASE_URL=https://<your-project-id>.supabase.co
# service_role key (Dashboard -> Project Settings -> API Keys -> Legacy API Keys).
# The pipeline writes rows and the public anon key is read-only. This key is a
# server-side secret: never commit it or ship it in client code.
SUPABASE_KEY=<your-service-role-key>
